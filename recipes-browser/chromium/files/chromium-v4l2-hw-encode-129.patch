   switch (input_buf.Memory()) {
+    case V4L2_MEMORY_MMAP: {
+      // Patched: Copy frame data to MMAP buffer (encoder allocates contiguous DMA memory)
+      // Handle both SHMEM and GpuMemoryBuffer frames with stride-aware copying
+      const uint8_t* src_data[VideoFrame::kMaxPlanes] = {};
+
+      if (frame->storage_type() == VideoFrame::STORAGE_GPU_MEMORY_BUFFER) {
+        // For GpuMemoryBuffer, we need to map it first to get CPU-accessible pointers
+        gfx::GpuMemoryBuffer* gmb = frame->GetGpuMemoryBuffer();
+        if (!gmb) {
+          SetErrorState({EncoderStatus::Codes::kInvalidInputFrame,
+                         "Failed to get GpuMemoryBuffer from frame"});
+          return false;
+        }
+        if (!gmb->Map()) {
+          SetErrorState({EncoderStatus::Codes::kInvalidInputFrame,
+                         "Failed to map GpuMemoryBuffer"});
+          return false;
+        }
+        for (size_t i = 0; i < num_planes; ++i) {
+          src_data[i] = static_cast<const uint8_t*>(gmb->memory(i));
+        }
+      } else {
+        // SHMEM or other mappable storage - use frame->data() directly
+        for (size_t i = 0; i < num_planes; ++i) {
+          src_data[i] = frame->data(i);
+        }
+      }
+
+      // Copy each plane with stride-aware row-by-row copying
+      // Source frames may have padding (e.g., 256 stride for 240-wide chroma)
+      // Destination uses stride derived from actual MMAP buffer size
+      const gfx::Size visible_size = encoder_input_visible_rect_.size();
+      for (size_t i = 0; i < num_planes; ++i) {
+        const int src_stride = frame->stride(i);
+
+        // Calculate row dimensions - chroma planes are half size for I420/NV12
+        int rows = visible_size.height();
+        int row_bytes = visible_size.width();
+        if (i > 0) {
+          rows = (visible_size.height() + 1) / 2;
+          row_bytes = (visible_size.width() + 1) / 2;
+        }
+
+        // Derive dst_stride from actual MMAP buffer size, not device_input_layout_
+        // (device_input_layout_ may incorrectly report Y plane stride for all planes,
+        // but kernel allocates I420 chroma buffers with correct half-stride)
+        const size_t mmap_size = input_buf.GetPlaneSize(i);
+        const int dst_stride = (rows > 0)
+            ? static_cast<int>(mmap_size / rows) : row_bytes;
+
+        // Verify dst_stride is at least row_bytes (sanity check)
+        if (dst_stride < row_bytes) {
+          LOG(ERROR) << "MMAP buffer stride too small: dst_stride=" << dst_stride
+                     << " row_bytes=" << row_bytes << " for plane " << i;
+          if (frame->storage_type() == VideoFrame::STORAGE_GPU_MEMORY_BUFFER) {
+            frame->GetGpuMemoryBuffer()->Unmap();
+          }
+          SetErrorState({EncoderStatus::Codes::kEncoderHardwareDriverError,
+                         "MMAP buffer stride too small"});
+          return false;
+        }
+
+        // Row-by-row copy: handle source stride padding, write at dst_stride layout
+        const uint8_t* src_row = src_data[i];
+        uint8_t* dst_row = static_cast<uint8_t*>(input_buf.GetPlaneMapping(i));
+        for (int row = 0; row < rows; ++row) {
+          memcpy(dst_row, src_row, row_bytes);
+          src_row += src_stride;
+          dst_row += dst_stride;
+        }
+      }
+
+      if (frame->storage_type() == VideoFrame::STORAGE_GPU_MEMORY_BUFFER) {
+        frame->GetGpuMemoryBuffer()->Unmap();
+      }
+
+      if (!std::move(input_buf).QueueMMap()) {
+        SetErrorState(
+            {EncoderStatus::Codes::kEncoderHardwareDriverError,
+             base::StrCat(
+                 {"Failed queue a MMAP buffer to input queue, errno=",
+                  base::NumberToString(errno)})});
+        return false;
+      }
+      break;
+    }
